{
  "name": "loom-design-system",
  "version": "6.0.0",
  "description": "Token-driven design system generator — produces a CSS substrate of tokens and a class layer, Figma variables and styles, and a handful of React atoms where behavior needs one, from a single config source.",
  "license": "MIT",
  "author": "Jacob Ikola",
  "private": true,
  "keywords": [
    "design-system",
    "design-tokens",
    "figma",
    "react",
    "codegen"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "configs": "node scripts/generate-configs/index.js --input spec/answers.json",
    "diff-emit": "node scripts/diff-emit.js",
    "figma": "node scripts/assemble-figma.js",
    "generate": "node scripts/code-templates/orchestrator.js",
    "sync": "node scripts/sync.js",
    "test:provenance": "node scripts/provenance.test.js",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
