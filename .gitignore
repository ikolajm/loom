# Dependencies
node_modules/

# Build output
.next/
out/
dist/
*.tsbuildinfo

# Generated on demand (created by scripts/code-templates/orchestrator.js)
generated/

# Your brand answers — hand-authored, project-specific, not Loom's look.
# Copy spec/answers.example.json → spec/answers.json and edit.
spec/answers.json

# ...and what `npm run configs` generates from them. The rule above covers the
# pipeline's input; this covers its output, which is the half that actually reached
# master twice with the wrong brand. Generators prefer this set and fall back to the
# committed spec/config/base/, so a fresh clone builds Loom's own look with no answers
# file at all. Together these two rules make the claim the first one used to make alone:
# generating your brand never dirties the Loom working tree.
spec/config/local/

# Logs / env / OS
*.log
.env*
.DS_Store
