{
  "$schema": "Internal standard — values locked across all projects. Do not override per-project.",

  "spacing": {
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    }
  },

  "sizing": {
    "border-radius": {
      "br-0": "0px",
      "br-1": "2px",
      "br-2": "4px",
      "br-3": "6px",
      "br-4": "8px",
      "br-5": "12px",
      "br-6": "16px",
      "br-7": "24px",
      "br-8": "28px",
      "br-9": "32px",
      "br-999": "9999px"
    },
    "border-width": {
      "bw-0": "0px",
      "bw-1": "1px",
      "bw-2": "2px",
      "bw-3": "4px"
    },
    "icon-size": {
      "icon-0": "12px",
      "icon-1": "16px",
      "icon-2": "20px",
      "icon-3": "24px",
      "icon-4": "32px"
    },
    "component-height": {
      "ch-0": "20px",
      "ch-1": "24px",
      "ch-2": "28px",
      "ch-3": "32px",
      "ch-4": "36px",
      "ch-5": "40px",
      "ch-6": "44px",
      "ch-7": "48px",
      "ch-8": "56px",
      "ch-9": "64px"
    },
    "touch-target": {
      "min": "44px"
    }
  },

  "effects": {
    "transition": {
      "$note": "One duration. Every transition in the class layer used a single value; the two other tiers that existed were emitted and never referenced. 150ms is the duration a user feels on every hover and focus — slow enough to read as motion, fast enough not to lag the pointer. A consumer retimes everything by overriding --transition. A second tier gets added when something needs it, not before.",
      "default": "150ms"
    },
    "easing": {
      "$note": "One curve. The four M3 bezier presets and the three spring linear() approximations were emitted and referenced by nothing; the springs were long enough to cost every consumer real bytes for it. Emitted as --easing, which a consumer overrides with any timing function, including their own spring.",
      "default": "ease"
    },
    "focus-ring": {
      "width": "2px",
      "offset": "2px",
      "color": "primary"
    },
    "opacity": {
      "$note": "State opacities. Universal and code-only, like transition and easing — they describe what a disabled or de-emphasised control looks like, not which brand it belongs to. Emitted as --opacity-{role}. `disabled` is read by the class layer, on .control:disabled. `muted` is NOT: its consumer was badge's dismiss control, which was removed when badge became a label that is never a target, and its three siblings (toast, file-upload) left with the catalog reduction. The role is kept rather than cut because it is published to Figma as opacity/muted with var(--opacity-muted) as its code syntax, so a designer can still reach for it, and because its direction is settled and easy to get backwards: a secondary control rests at muted and returns to full on hover, never the reverse. Two of the four sibling dismiss controls did the opposite before that was fixed. A future component wanting it writes opacity: var(--opacity-muted) and the hover return; there is no class for it, because a class for a component that does not exist yet is structure ahead of need.",
      "disabled": 0.5,
      "muted": 0.7
    },
    "shadow": {
      "$note": "Shadow levels generated in config/base/effects.json. shadow-0 (none) through shadow-N."
    }
  },

  "colors": {
    "$note": "Both light and dark are equal mapping schemes. Which one loads first is a per-project answer and lives in the generated config/base/colors.json → default-mode, not here — this file is locked across projects and must not carry a value the questionnaire sets. Fixed variants reference the same palette stops in both modes — explicitly modeled in each.",

    "modes": {
      "light": {
        "primary": {
          "primary": "{fill.primary.600}",
          "on-primary": "#FFFFFF",
          "primary-text": "{readable.primary.600}",
        "primary-border": "{boundary.primary.600}",
          "primary-container": "{fill.primary.100}",
          "on-primary-container": "{palette.primary.900}",
          "primary-fixed": "{fill.primary.200}",
          "primary-fixed-dim": "{palette.primary.300}",
          "on-primary-fixed": "{palette.primary.900}",
          "on-primary-fixed-variant": "{palette.primary.700}"
        },
        "secondary": {
          "secondary": "{fill.secondary.600}",
          "on-secondary": "#FFFFFF",
          "secondary-text": "{readable.secondary.600}",
        "secondary-border": "{boundary.secondary.600}",
          "secondary-container": "{fill.secondary.100}",
          "on-secondary-container": "{palette.secondary.900}",
          "secondary-fixed": "{fill.secondary.200}",
          "secondary-fixed-dim": "{palette.secondary.300}",
          "on-secondary-fixed": "{palette.secondary.900}",
          "on-secondary-fixed-variant": "{palette.secondary.700}"
        },
        "neutral": {
          "neutral": "{fill.neutral.60}",
          "on-neutral": "#FFFFFF",
          "neutral-container": "{fill.neutral.90}",
          "on-neutral-container": "{palette.neutral.10}"
        },
        "surface": {
          "surface": "{fill.neutral.95}",
          "surface-1": "{palette.neutral.90}",
          "surface-2": "{palette.neutral.85}",
          "surface-3": "{palette.neutral.80}",
          "on-surface": "{palette.neutral.10}",
          "on-surface-variant": "{palette.neutral.30}",
          "surface-inverse": "{fill.primary.800}",
          "on-surface-inverse": "{palette.neutral.95}",
          "inverse-primary": "{palette.primary.300}",
          "scrim": "rgba(0, 0, 0, 0.3)"
        },
        "outline": {
          "outline": "{palette.neutral.50}",
          "outline-subtle": "{palette.neutral.80}"
        },
        "error": {
          "error": "{fill.error.600}",
          "on-error": "#FFFFFF",
          "error-text": "{readable.error.600}",
        "error-border": "{boundary.error.600}",
          "error-container": "{fill.error.100}",
          "on-error-container": "{palette.error.900}"
        },
        "success": {
          "success": "{fill.success.600}",
          "on-success": "#FFFFFF",
          "success-text": "{readable.success.600}",
        "success-border": "{boundary.success.600}",
          "success-container": "{fill.success.100}",
          "on-success-container": "{palette.success.900}"
        },
        "warning": {
          "warning": "{fill.warning.600}",
          "on-warning": "#FFFFFF",
          "warning-text": "{readable.warning.600}",
        "warning-border": "{boundary.warning.600}",
          "warning-container": "{fill.warning.100}",
          "on-warning-container": "{palette.warning.900}"
        },
        "info": {
          "info": "{fill.info.600}",
          "on-info": "#FFFFFF",
          "info-text": "{readable.info.600}",
        "info-border": "{boundary.info.600}",
          "info-container": "{fill.info.100}",
          "on-info-container": "{palette.info.900}"
        },
        "common": {
          "on-color": "#FFFFFF"
        }
      },

      "dark": {
        "primary": {
          "primary": "{fill.primary.300}",
          "on-primary": "{palette.primary.900}",
          "primary-text": "{readable.primary.300}",
        "primary-border": "{boundary.primary.300}",
          "primary-container": "{fill.primary.800}",
          "on-primary-container": "{palette.primary.100}",
          "primary-fixed": "{fill.primary.200}",
          "primary-fixed-dim": "{palette.primary.300}",
          "on-primary-fixed": "{palette.primary.900}",
          "on-primary-fixed-variant": "{palette.primary.700}"
        },
        "secondary": {
          "secondary": "{fill.secondary.300}",
          "on-secondary": "{palette.secondary.900}",
          "secondary-text": "{readable.secondary.300}",
        "secondary-border": "{boundary.secondary.300}",
          "secondary-container": "{fill.secondary.800}",
          "on-secondary-container": "{palette.secondary.100}",
          "secondary-fixed": "{fill.secondary.200}",
          "secondary-fixed-dim": "{palette.secondary.300}",
          "on-secondary-fixed": "{palette.secondary.900}",
          "on-secondary-fixed-variant": "{palette.secondary.700}"
        },
        "neutral": {
          "neutral": "{fill.neutral.80}",
          "on-neutral": "{palette.neutral.10}",
          "neutral-container": "{fill.neutral.25}",
          "on-neutral-container": "{palette.neutral.90}"
        },
        "surface": {
          "surface": "{fill.neutral.10}",
          "surface-1": "{palette.neutral.15}",
          "surface-2": "{palette.neutral.25}",
          "surface-3": "{palette.neutral.30}",
          "on-surface": "{palette.neutral.90}",
          "on-surface-variant": "{palette.neutral.80}",
          "surface-inverse": "{fill.primary.100}",
          "on-surface-inverse": "{palette.neutral.20}",
          "inverse-primary": "{palette.primary.600}",
          "scrim": "rgba(0, 0, 0, 0.5)"
        },
        "outline": {
          "outline": "{palette.neutral.60}",
          "outline-subtle": "{palette.neutral.30}"
        },
        "error": {
          "error": "{fill.error.400}",
          "on-error": "{palette.error.900}",
          "error-text": "{readable.error.400}",
        "error-border": "{boundary.error.400}",
          "error-container": "{fill.error.800}",
          "on-error-container": "{palette.error.100}"
        },
        "success": {
          "success": "{fill.success.400}",
          "on-success": "{palette.success.900}",
          "success-text": "{readable.success.400}",
        "success-border": "{boundary.success.400}",
          "success-container": "{fill.success.800}",
          "on-success-container": "{palette.success.100}"
        },
        "warning": {
          "warning": "{fill.warning.400}",
          "on-warning": "{palette.warning.900}",
          "warning-text": "{readable.warning.400}",
        "warning-border": "{boundary.warning.400}",
          "warning-container": "{fill.warning.800}",
          "on-warning-container": "{palette.warning.100}"
        },
        "info": {
          "info": "{fill.info.400}",
          "on-info": "{palette.info.900}",
          "info-text": "{readable.info.400}",
        "info-border": "{boundary.info.400}",
          "info-container": "{fill.info.800}",
          "on-info-container": "{palette.info.100}"
        },
