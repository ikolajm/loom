{
  "button": {
    "$catalog": {
      "category": "button",
      "description": "Primary action button — orthogonal variant (filled/outline/ghost) × color (primary/secondary/destructive/success/warning/neutral/inherit). Sizes determine padding/typography. Supports iconOnly mode, leading/trailing icon slots, loading state. Slottable composition for asChild alongside icons. The `inherit` color reads currentColor — for icon-button affordances embedded in colored surfaces (e.g. a Banner dismiss) that must take the parent's foreground.",
      "dependencies": ["cn"],
      "tokens": ["color", "typography", "spacing", "sizing"],
      "composition": "slottable"
    },
    "$note": "Orthogonal model — variant (treatment: filled/outline/ghost) and color (primary/secondary/destructive/success/warning/neutral) are INDEPENDENT CVA axes. Color is declared once as 4 CSS-var token refs: bg/fg drive the solid fill; text/border drive the line+label. Each treatment is a fixed consumer of those vars (see shared TREATMENT_CLASSES) — no N×M compound matrix. Default filled+primary reproduces the old `default`. neutral's text/border split lets its outline stay a subtle line with readable on-surface text.",
    "treatments": ["filled", "outline", "ghost"],
    "colors": {
      "primary":     { "bg": "color/primary/primary",     "fg": "color/primary/on-primary",     "text": "color/primary/primary",     "border": "color/primary/primary" },
      "secondary":   { "bg": "color/secondary/secondary", "fg": "color/secondary/on-secondary", "text": "color/secondary/secondary", "border": "color/secondary/secondary" },
      "destructive": { "bg": "color/error/error",         "fg": "color/error/on-error",         "text": "color/error/error",         "border": "color/error/error" },
      "success":     { "bg": "color/success/success",     "fg": "color/success/on-success",     "text": "color/success/success",     "border": "color/success/success" },
      "warning":     { "bg": "color/warning/warning",     "fg": "color/warning/on-warning",     "text": "color/warning/warning",     "border": "color/warning/warning" },
      "neutral":     { "bg": "color/neutral/neutral",     "fg": "color/neutral/on-neutral",     "text": "color/surface/on-surface",  "border": "color/outline/outline" },
      "inherit":     { "bg": "transparent",               "fg": "currentColor",                 "text": "currentColor",              "border": "currentColor" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 500,
      "letter-spacing": "0.01em",
      "text-transform": "none"
    },
    "icon-slots": {
      "leading":  { "default-visible": false, "default-icon": "icon/placeholder" },
      "trailing": { "default-visible": false, "default-icon": "icon/placeholder" }
    },
    "sizes": {
      "sm":   { "height": "height/ch-3", "x-padding": "{scale.3}", "y-padding": "{scale.1}", "gap": "{scale.1}", "font-size": "12px", "line-height": "16px", "radius": "radius/component", "icon-size": "icon/icon-1" },
      "md":   { "height": "height/ch-5", "x-padding": "{scale.4}", "y-padding": "{scale.2}", "gap": "{scale.2}", "font-size": "14px", "line-height": "20px", "radius": "radius/component", "icon-size": "icon/icon-2" },
      "lg":   { "height": "height/ch-7", "x-padding": "{scale.6}", "y-padding": "{scale.3}", "gap": "{scale.2}", "font-size": "16px", "line-height": "24px", "radius": "radius/component", "icon-size": "icon/icon-3" }
    },
    "icon-sizes": {
      "$note": "Square sizing for icon-only mode (iconOnly prop). No padding — icon centers via flexbox. Touch target met at all sizes.",
      "sm":   { "size": "height/ch-3", "radius": "radius/component", "icon-size": "icon/icon-1" },
      "md":   { "size": "height/ch-5", "radius": "radius/component", "icon-size": "icon/icon-2" },
      "lg":   { "size": "height/ch-7", "radius": "radius/component", "icon-size": "icon/icon-3" }
    },
    "default": { "variant": "filled", "color": "primary", "size": "md" }
  },
  "badge": {
    "$catalog": {
      "category": "button",
      "description": "Label with optional icon, severity, interactive/removable modes. Visual treatments: filled, outline. Consolidates prior chip / tag-chip (= outline + neutral). The status dot is its own `dot` atom.",
      "dependencies": ["cn"],
      "tokens": ["color", "typography", "spacing", "sizing"],
      "composition": "slot"
    },
    "$note": "Orthogonal axes — variant (treatment: filled/outline) and state (color/severity) are independent. State is declared once as 4 CSS-var token refs: bg/fg = container fill + on-container text (filled); text/border = base color (outline line/text). Treatments are fixed consumers of those vars (shared TREATMENT_CLASSES) — no compound matrix. Body radius is radius/component (malleable with edges). The status dot is its own atom (`dot`) — compose it into a badge if needed. Behavior modes (interactive, onRemove) are template-level props.",
    "treatments": ["filled", "outline"],
    "colors": {
      "default":     { "bg": "color/primary/primary-container",   "fg": "color/primary/on-primary-container",   "text": "color/primary/primary",   "border": "color/primary/primary" },
      "neutral":     { "bg": "color/neutral/neutral-container",   "fg": "color/neutral/on-neutral-container",   "text": "color/neutral/neutral",   "border": "color/neutral/neutral" },
      "destructive": { "bg": "color/error/error-container",       "fg": "color/error/on-error-container",       "text": "color/error/error",       "border": "color/error/error" },
      "success":     { "bg": "color/success/success-container",   "fg": "color/success/on-success-container",   "text": "color/success/success",   "border": "color/success/success" },
      "warning":     { "bg": "color/warning/warning-container",   "fg": "color/warning/on-warning-container",   "text": "color/warning/warning",   "border": "color/warning/warning" },
      "info":        { "bg": "color/info/info-container",         "fg": "color/info/on-info-container",         "text": "color/info/info",         "border": "color/info/info" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 500,
      "letter-spacing": "0.02em",
      "text-transform": "none"
    },
    "icon-slots": {
      "$note": "Suppressed for dot variant.",
      "leading":  { "default-visible": false, "default-icon": "icon/placeholder" },
      "trailing": { "default-visible": false, "default-icon": "icon/placeholder" }
    },
    "sizes": {
      "sm": { "x-padding": "{scale.1}", "y-padding": "2px", "$exception": "2px y-padding — below spacing scale minimum (4px). Required to maintain proportional badge height at 10px font size.", "gap": "{scale.1}", "font-size": "10px", "line-height": "14px", "radius": "radius/component", "icon": "icon/icon-0" },
      "md": { "x-padding": "{scale.2}", "y-padding": "{scale.1}", "gap": "{scale.1}", "font-size": "10px", "line-height": "14px", "radius": "radius/component", "icon": "icon/icon-0" },
      "lg": { "x-padding": "{scale.3}", "y-padding": "{scale.1}", "gap": "{scale.1}", "font-size": "12px", "line-height": "16px", "radius": "radius/component", "icon": "icon/icon-1" }
    },
    "default": { "variant": "filled", "state": "default", "size": "md" }
  },
  "dot": {
    "$catalog": {
      "category": "feedback",
      "description": "Status/severity indicator dot — a small colored circle keyed by state. Standalone primitive; compose into badges, banners, list items, subheadings, nav. For a notification count bubble, use Badge size=\"sm\".",
      "dependencies": ["cn"],
      "tokens": ["color", "sizing"],
      "composition": "none"
    },
    "$note": "Single-axis atom: state → base color fill. Always a circle (rounded-pill). No text/icon. Sizes reuse icon tokens.",
    "state": {
      "default":     { "bg": "color/primary/primary" },
      "neutral":     { "bg": "color/neutral/neutral" },
      "destructive": { "bg": "color/error/error" },
      "success":     { "bg": "color/success/success" },
      "warning":     { "bg": "color/warning/warning" },
      "info":        { "bg": "color/info/info" }
    },
    "sizes": {
      "sm": { "size": "icon/icon-0" },
      "md": { "size": "icon/icon-1" },
      "lg": { "size": "icon/icon-2" }
    },
    "default": { "state": "default", "size": "md" }
  },
  "fab": {
    "$catalog": {
      "category": "button",
      "description": "Floating action button — primary screen action. Single variant by design. Extended mode adds a text label next to the icon. Positioning is consumer responsibility.",
      "dependencies": ["cn"],
      "tokens": ["color", "typography", "spacing", "sizing", "effects"],
      "composition": "slot"
    },
    "$note": "Floating action button. Primary screen action, one per screen. Positioned fixed bottom-right. Extended variant adds a text label next to the icon. Uses primary-container for a softer presence than button's saturated primary fill.",
    "variants": {
      "default": { "bg": "color/primary/primary-container", "fg": "color/primary/on-primary-container" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 500,
      "letter-spacing": "0.01em",
      "text-transform": "none"
    },
    "sizes": {
      "sm": { "size": "height/ch-4", "radius": "radius/card", "icon-size": "icon/icon-2", "shadow": "effects/shadow-2" },
      "md": { "size": "height/ch-6", "radius": "radius/card", "icon-size": "icon/icon-3", "shadow": "effects/shadow-3" },
      "lg": { "size": "height/ch-8", "radius": "radius/card", "icon-size": "icon/icon-3", "shadow": "effects/shadow-3" }
    },
    "extended": {
      "$note": "Extended FAB adds a label. Allowed at all sizes incl. sm (sm uses compact 12px label typography).",
      "sm": { "height": "height/ch-4", "x-padding": "{scale.3}", "gap": "{scale.2}", "font-size": "12px", "line-height": "16px" },
      "md": { "height": "height/ch-6", "x-padding": "{scale.4}", "gap": "{scale.2}", "font-size": "14px", "line-height": "20px" },
      "lg": { "height": "height/ch-8", "x-padding": "{scale.5}", "gap": "{scale.3}", "font-size": "16px", "line-height": "24px" }
    },
    "default": { "variant": "default", "size": "md" }
  },
  "fab-menu": {
    "$catalog": {
      "category": "button",
      "description": "FAB that expands into a vertical stack of action buttons (M3 speed-dial pattern). Trigger FAB + FabAction subcomponents. Static open/closed in Sprint 1; expand animation wraps via motion library in Sprint 2.",
      "dependencies": ["fab", "cn"],
      "tokens": ["color", "typography", "spacing", "sizing", "effects"],
      "composition": "slot"
    },
    "$note": "Trigger uses fab styling. Actions stack vertically above the trigger. Each action is a smaller circular button + optional label. No backdrop scrim by default.",
    "variants": {
      "default": { "bg": "color/primary/primary-container", "fg": "color/primary/on-primary-container" }
    },
    "trigger-sizes": {
      "$note": "Trigger FAB sizes — matches fab atom.",
      "sm": { "size": "height/ch-4", "radius": "radius/card", "icon-size": "icon/icon-2", "shadow": "effects/shadow-2" },
      "md": { "size": "height/ch-6", "radius": "radius/card", "icon-size": "icon/icon-3", "shadow": "effects/shadow-3" },
      "lg": { "size": "height/ch-8", "radius": "radius/card", "icon-size": "icon/icon-3", "shadow": "effects/shadow-3" }
    },
    "action-sizes": {
      "$note": "Action button sizes — one step smaller than trigger. Circular by default; extended adds label.",
      "sm": { "size": "height/ch-3", "radius": "radius/card", "icon-size": "icon/icon-1", "shadow": "effects/shadow-1" },
      "md": { "size": "height/ch-5", "radius": "radius/card", "icon-size": "icon/icon-2", "shadow": "effects/shadow-2" },
      "lg": { "size": "height/ch-7", "radius": "radius/card", "icon-size": "icon/icon-3", "shadow": "effects/shadow-2" }
    },
    "stack-spacing": {
      "$note": "Gap between stacked actions when expanded.",
      "sm": "{scale.2}",
      "md": "{scale.3}",
      "lg": "{scale.3}"
    },
    "action-label": {
      "$note": "Optional label rendered next to action (right side). Pill shape, small typography.",
      "font-family": "body",
      "font-weight": 500,
      "font-size": "12px",
      "line-height": "16px",
      "letter-spacing": "0.01em",
      "x-padding": "{scale.2}",
      "y-padding": "{scale.1}",
      "radius": "radius/component",
      "bg": "color/surface/surface-2",
      "fg": "color/surface/on-surface"
    },
    "default": { "variant": "default", "size": "md" }
  },

  "toggle": {
    "$catalog": {
      "category": "button",
      "description": "Single toggle button with pressed/unpressed states. Distinct from Switch (slider) and Badge in interactive mode. Uses Radix Toggle for state + a11y.",
      "dependencies": ["cn"],
      "tokens": ["color", "typography", "spacing", "sizing"],
      "composition": "none"
    },
    "$note": "Single toggle button with pressed/unpressed states. Distinct from Switch (slider control) and Chip (selection tag). Used for toolbar actions (bold, italic), view toggles, feature on/off. aria-pressed required.",
    "state": {
      "unpressed": { "bg": "transparent", "fg": "color/surface/on-surface-variant", "border": "color/outline/outline-subtle" },
      "pressed":   { "bg": "color/primary/primary-container", "fg": "color/primary/on-primary-container", "border": "color/primary/primary-container" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 500,
      "letter-spacing": "0.01em",
      "text-transform": "none"
    },
    "icon-slots": {
      "leading":  { "default-visible": false, "default-icon": "icon/placeholder" },
      "trailing": { "default-visible": false, "default-icon": "icon/placeholder" }
    },
    "sizes": {
      "sm": { "height": "height/ch-3", "x-padding": "{scale.2}", "y-padding": "{scale.1}", "gap": "{scale.1}", "radius": "radius/component", "icon-size": "icon/icon-1", "font-size": "12px", "line-height": "16px" },
      "md": { "height": "height/ch-5", "x-padding": "{scale.3}", "y-padding": "{scale.2}", "gap": "{scale.2}", "radius": "radius/component", "icon-size": "icon/icon-2", "font-size": "14px", "line-height": "20px" },
      "lg": { "height": "height/ch-7", "x-padding": "{scale.4}", "y-padding": "{scale.2}", "gap": "{scale.2}", "radius": "radius/component", "icon-size": "icon/icon-2", "font-size": "16px", "line-height": "24px" }
    },
    "default": { "state": "unpressed", "size": "md" }
  },

  "toggle-group": {
    "$catalog": {
      "category": "button",
      "description": "Group of toggle buttons — exclusive (single select) or multi-select. Segmented variant joins items with shared borders; spaced variant adds visible gaps.",
      "dependencies": ["toggle", "cn"],
      "tokens": ["color", "spacing", "sizing"],
      "composition": "none"
    },
    "$note": "Group of toggle buttons — exclusive (single select) or multi-select. Segmented variant: items share borders, radius collapses to first/last only (absorbs M3 segmented-button). Spaced variant: visible gaps between items, each toggle has its own borders/radius.",
    "variants": {
      "segmented": {
        "$note": "Items touch (no gap), share borders, radius collapses to first/last only.",
        "bg": "transparent",
        "border": "color/outline/outline-subtle",
        "gap": "{scale.0}"
      },
      "spaced": {
        "$note": "Visible gaps between items, each toggle has its own borders/radius.",
        "bg": "transparent",
        "border": "transparent",
        "gap": "{scale.2}"
      }
    },
    "sizes": {
      "sm": { "height": "height/ch-3", "radius": "radius/component" },
      "md": { "height": "height/ch-5", "radius": "radius/component" },
      "lg": { "height": "height/ch-7", "radius": "radius/component" }
    },
    "default": { "variant": "segmented", "size": "md" }
  }
}
