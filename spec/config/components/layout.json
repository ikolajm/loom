{
  "card": {
    "variants": {
      "default":  { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "border": "color/outline/outline", "shadow": "effects/shadow-1" },
      "elevated": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "border": "none", "shadow": "effects/shadow-2" },
      "outline":  { "bg": "transparent", "fg": "color/surface/on-surface", "border": "color/outline/outline", "shadow": "effects/shadow-0" },
      "flush":    { "bg": "transparent", "fg": "color/surface/on-surface", "border": "none", "shadow": "effects/shadow-0" }
    },
    "sizes": {
      "$constant": { "radius": "radius/card" },
      "sm": { "x-padding": "{scale.4}", "y-padding": "{scale.3}", "gap": "{scale.3}" },
      "md": { "x-padding": "{scale.6}", "y-padding": "{scale.4}", "gap": "{scale.4}" },
      "lg": { "x-padding": "{scale.8}", "y-padding": "{scale.6}", "gap": "{scale.6}" }
    },
    "default": { "variant": "default", "size": "md" }
  },
  "dialog": {
    "$catalog": {
        "dependencies": ["cn", "button"] },
    "variants": {
      "default": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "overlay": "color/surface/scrim", "shadow": "effects/shadow-3" }
    },
    "sizes": {
      "$exception": "Dialog max-widths are hardcoded — layout-specific breakpoints, not derivable from spacing or sizing primitives.",
      "sm":   { "max-width": "400px", "x-padding": "{scale.4}", "y-padding": "{scale.4}", "gap": "{scale.4}", "radius": "radius/modal" },
      "md":   { "max-width": "560px", "x-padding": "{scale.6}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" },
      "lg":   { "max-width": "720px", "x-padding": "{scale.8}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" },
      "$note": "`full` takes md's type role explicitly. It is a width tier, not a type tier, so the family+tier derivation has no `body/full` to find and emitted five undefined custom properties. The atom carried no text class here at all and inherited whatever ancestor it landed in.",
      "full": { "max-width": "100%",  "x-padding": "{scale.6}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/component", "text": "body/md" }
    },
    "default": { "variant": "default", "size": "md" }
  },
  "tab": {
    "$note": "One tab in a `.tab-list`: the list is a tinted track, the selected tab filled primary on it. Selection reads `aria-selected`, never a framework's data attribute, so the look cannot disagree with what assistive tech announces and a tab list rendered without a framework looks the same. Every label takes the same weight, so selecting one moves nothing beside it. The fill is the state cue, and it is solid because nothing fainter carries one: a surface step against the track is well short of the 3:1 WCAG 1.4.11 asks, and the soft container matches the track's luminance and separates by hue alone. Heights are the control ladder, as button's.",
    "sizes": {
      "$constant": { "radius": "radius/component" },
      "sm": { "height": "height/control-sm", "x-padding": "{scale.3}", "y-padding": "{scale.1}", "gap": "{scale.1}", "icon-size": "icon/icon-1" },
      "md": { "height": "height/control-md", "x-padding": "{scale.4}", "y-padding": "{scale.2}", "gap": "{scale.2}", "icon-size": "icon/icon-2" },
      "lg": { "height": "height/control-lg", "x-padding": "{scale.6}", "y-padding": "{scale.3}", "gap": "{scale.2}", "icon-size": "icon/icon-3" }
    },
    "default": { "size": "md" }
  },
  "table": {
    "variants": {
      "default": { "header-fg": "color/surface/on-surface-variant", "row-fg": "color/surface/on-surface", "border": "color/outline/outline" }
    },
    "typography": {
      "header": { "font-weight": 500 },
      "cell": { "font-weight": 400 }
    },
    "sizes": {
      "sm": { "x-padding": "{scale.3}", "y-padding": "{scale.1}", "text": "body/sm" },
      "md": { "x-padding": "{scale.4}", "y-padding": "{scale.2}", "text": "body/sm" },
      "lg": { "x-padding": "{scale.6}", "y-padding": "{scale.3}", "text": "body/md" }
    },
    "default": { "variant": "default", "size": "md" }
  }
}
