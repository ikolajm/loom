{
  "card": {
    "variants": {
      "default":  { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "border": "color/outline/outline", "shadow": "effects/shadow-1" },
      "elevated": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "border": "none", "shadow": "effects/shadow-2" },
      "outline":  { "bg": "transparent", "fg": "color/surface/on-surface", "border": "color/outline/outline", "shadow": "effects/shadow-0" },
      "flush":    { "bg": "transparent", "fg": "color/surface/on-surface", "border": "none", "shadow": "effects/shadow-0" }
    },
    "sizes": {
      "sm": { "x-padding": "{scale.4}", "y-padding": "{scale.3}", "gap": "{scale.3}", "radius": "radius/card" },
      "md": { "x-padding": "{scale.6}", "y-padding": "{scale.4}", "gap": "{scale.4}", "radius": "radius/card" },
      "lg": { "x-padding": "{scale.8}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/card" }
    },
    "default": { "variant": "default", "size": "md" }
  },
  "dialog": {
    "$catalog": { "dependencies": ["cn", "button"] },
    "variants": {
      "default": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "overlay": "color/surface/scrim", "shadow": "effects/shadow-3" }
    },
    "sizes": {
      "$exception": "Dialog max-widths are hardcoded — layout-specific breakpoints, not derivable from spacing or sizing primitives.",
      "sm":   { "max-width": "400px", "x-padding": "{scale.4}", "y-padding": "{scale.4}", "gap": "{scale.4}", "radius": "radius/modal" },
      "md":   { "max-width": "560px", "x-padding": "{scale.6}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" },
      "lg":   { "max-width": "720px", "x-padding": "{scale.8}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" },
      "full": { "max-width": "100%",  "x-padding": "{scale.6}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/component" }
    },
    "default": { "variant": "default", "size": "md" }
  },
  "table": {
    "variants": {
      "default": { "header-fg": "color/surface/on-surface-variant", "row-fg": "color/surface/on-surface", "border": "color/outline/outline" }
    },
    "typography": {
      "header": {
        "font-family": "body",
        "font-weight": 500,
        "letter-spacing": "0",
        "text-transform": "none"
      },
      "cell": {
        "font-family": "body",
        "font-weight": 400,
        "letter-spacing": "0",
        "text-transform": "none"
      }
    },
    "sizes": {
      "sm": { "x-padding": "{scale.3}", "y-padding": "{scale.1}", "text": "body/sm" },
      "md": { "x-padding": "{scale.4}", "y-padding": "{scale.2}", "text": "body/sm" },
      "lg": { "x-padding": "{scale.6}", "y-padding": "{scale.3}", "text": "body/md" }
    },
    "default": { "variant": "default", "size": "md" }
  },
  "sheet": {
    "$catalog": { "dependencies": ["cn", "button"] },
    "$note": "Overlay panel anchored to one edge — top, bottom, left or right. Shares dialog's overlay/scrim model; dismiss via scrim click, escape or the close control. Corners round on the exposed edges only. **This is a sheet, not a drawer.** A drawer is a mobile affordance: a drag handle, a swipe-to-dismiss gesture, and momentum. None of that is here and none of it is planned — it needs touch-gesture handling this catalog does not do, and a component that half-implements it teaches the wrong thing. There is deliberately no drag-handle token: the handle is the affordance that would promise the gesture, so declaring one without the behaviour is the ambiguity, not the cure.",
    "variants": {
      "default": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "overlay": "color/surface/scrim", "shadow": "effects/shadow-3" }
    },
    "sizes": {
      "sm":   { "max-width": "320px", "x-padding": "{scale.4}", "y-padding": "{scale.4}", "gap": "{scale.4}", "radius": "radius/modal" },
      "md":   { "max-width": "400px", "x-padding": "{scale.6}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" },
      "lg":   { "max-width": "560px", "x-padding": "{scale.8}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" }
    },
    "default": { "variant": "default", "size": "md" }
  },
  "separator": {
    "color": "color/outline/outline-subtle",
    "width": "border-width/bw-1"
  },

  "alert-dialog": {
    "$note": "Stricter dialog variant for destructive or critical confirmations. No dismiss on click-outside or escape — user must take an explicit action (confirm or cancel). Shares dialog's visual styling but enforces modal behavior. Use for delete confirmations, irreversible actions, data loss warnings. **Kept separate from `dialog` deliberately**, after weighing a fold into a prop: Radix ships these as two primitives with different ARIA roles — `alertdialog` versus `dialog` — which screen readers announce differently, and the focus trap and no-dismiss behaviour are native to the primitive rather than layered on. A `required` flag on Dialog would have to swap the underlying primitive anyway, so the fold trades two honest components for one component with a hidden mode switch. The exports are the cost; the role is the reason.",
    "variants": {
      "default": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "overlay": "color/surface/scrim", "shadow": "effects/shadow-3" }
    },
    "sizes": {
      "sm": { "max-width": "400px", "x-padding": "{scale.4}", "y-padding": "{scale.4}", "gap": "{scale.4}", "radius": "radius/modal" },
      "md": { "max-width": "480px", "x-padding": "{scale.6}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" },
      "lg": { "max-width": "560px", "x-padding": "{scale.8}", "y-padding": "{scale.6}", "gap": "{scale.6}", "radius": "radius/modal" }
    },
    "default": { "variant": "default", "size": "md" }
  },

  "toolbar": {
    "$catalog": {
      "category": "layout",
      "description": "Horizontal flex container for grouped actions — houses buttons, toggles, separators, dropdowns. Children render as-is.",
      "dependencies": ["cn"],
      "tokens": ["color", "typography", "spacing", "sizing"],
      "composition": "none"
    },
    "variants": {
      "default": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "border": "color/outline/outline" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 400,
      "letter-spacing": "0",
      "text-transform": "none"
    },
    "sizes": {
      "sm": { "x-padding": "{scale.2}", "y-padding": "{scale.1}", "gap": "{scale.1}" },
      "md": { "x-padding": "{scale.3}", "y-padding": "{scale.2}", "gap": "{scale.2}" },
      "lg": { "x-padding": "{scale.5}", "y-padding": "{scale.3}", "gap": "{scale.3}" }
    },
    "default": { "variant": "default", "size": "md" }
  }
}
