{
  "text-field": {
    "$note": "Shared visual foundation for all text-input-style components (input, select, textarea, date-picker). Components reference this base — changing it changes all text fields uniformly.",
    "state": {
      "default": { "bg": "color/surface/surface", "fg": "color/surface/on-surface", "border": "color/outline/outline", "placeholder": "color/surface/on-surface-variant" },
      "error":   { "bg": "color/surface/surface", "fg": "color/surface/on-surface", "border": "color/error/error", "placeholder": "color/surface/on-surface-variant" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 400,
      "letter-spacing": "0",
      "text-transform": "none"
    },
    "icon-slots": {
      "leading":  { "default-visible": false, "default-icon": "icon/placeholder" },
      "trailing": { "default-visible": false, "default-icon": "icon/placeholder" }
    },
    "width": "280px",
    "sizes": {
      "$constant": { "gap": "{scale.2}", "radius": "radius/input" },
      "sm": { "height": "height/control-sm", "x-padding": "{scale.3}", "y-padding": "{scale.1}", "icon-size": "icon/icon-1" },
      "md": { "height": "height/control-md", "x-padding": "{scale.4}", "y-padding": "{scale.2}", "icon-size": "icon/icon-2" },
      "lg": { "height": "height/control-lg", "x-padding": "{scale.4}", "y-padding": "{scale.3}", "icon-size": "icon/icon-3" }
    }
  },

  "input": {
    "$base": "text-field",
    "default": { "state": "default", "size": "md" }
  },

  "select": {
    "$base": "text-field",
    "state": {
      "default": { "indicator": "color/surface/on-surface-variant" },
      "error":   { "indicator": "color/surface/on-surface-variant" }
    },
    "icon-slots": {
      "trailing": { "default-visible": true, "default-icon": "icon/chevron-down", "persistent": true }
    },
    "default": { "state": "default", "size": "md" }
  },

  "textarea": {
    "$base": "text-field",
    "$note": "Extends text-field but replaces fixed height with min-height. No icon slots — trailing/leading icons don't apply to multi-line input.",
    "$exception": "Textarea min-heights are hardcoded — content-area minimums specific to multi-line input, not derivable from sizing primitives.",
    "sizes": {
      "$constant": { "gap": "{scale.2}", "radius": "radius/input" },
      "sm": { "min-height": "80px", "x-padding": "{scale.3}", "y-padding": "{scale.2}" },
      "md": { "min-height": "120px", "x-padding": "{scale.4}", "y-padding": "{scale.3}" },
      "lg": { "min-height": "160px", "x-padding": "{scale.4}", "y-padding": "{scale.3}" }
    },
    "resize": "vertical",
    "default": { "state": "default", "size": "md" }
  },

  "date-picker": {
    "$catalog": { "dependencies": ["cn", "popover", "calendar", "form-field"] },
    "$base": "text-field",
    "$note": "Text-field variant with a persistent calendar trailing icon that opens a Calendar in a Popover. The panel was deferred at authoring time and has since shipped — the atom composes popover + calendar.",
    "icon-slots": {
      "trailing": { "default-visible": true, "default-icon": "icon/calendar", "persistent": true }
    },
    "default": { "state": "default", "size": "md" }
  },

  "toggle-base": {
    "$note": "Shared visual foundation for binary toggle controls (checkbox, radio). Same state logic, same sizes, different shape.",
    "checked": {
      "false": { "bg": "color/surface/surface", "border": "color/outline/outline" },
      "true":  { "bg": "color/primary/primary", "fg": "color/primary/on-primary", "border": "color/primary/primary" }
    },
    "$exception": "Toggle indicator sizes are hardcoded — proportional to the control's visual weight, not derived from icon or component-height primitives.",
    "sizes": {
      "sm": { "size": "16px" },
      "md": { "size": "20px" },
      "lg": { "size": "24px" }
    }
  },

  "checkbox": {
    "$base": "toggle-base",
    "radius": "radius/component",
    "default": { "checked": "false", "size": "md" }
  },

  "radio": {
    "$base": "toggle-base",
    "radius": "radius/pill",
    "$note": "Visually identical to checkbox but circular. Radio buttons operate in exclusive groups — only one selected at a time within a group.",
    "default": { "checked": "false", "size": "md" }
  },

  "switch": {
    "active": {
      "false": { "track-bg": "color/surface/surface-1", "thumb-bg": "color/surface/on-surface-variant" },
      "true":  { "track-bg": "color/primary/primary", "thumb-bg": "color/primary/on-primary" }
    },
    "$exception": "Switch track dimensions are hardcoded as a cohesive set — width:height ratio is intentional and should not drift independently via primitives.",
    "sizes": {
      "$constant": { "radius": "radius/pill" },
      "sm": { "width": "36px", "height": "20px" },
      "md": { "width": "44px", "height": "24px" },
      "lg": { "width": "52px", "height": "28px" }
    },
    "default": { "active": "false", "size": "md" }
  },

  "combobox": {
    "$catalog": { "dependencies": ["cn", "popover", "form-field"] },
    "$base": "text-field",
    "$note": "Combines text input with filterable dropdown. Extends text-field for the trigger, adds dropdown panel styling. Keyboard navigation required (arrow keys, enter, escape). Single-select, multi-select, and creatable variants share the same config — variant logic is code-only.",
    "icon-slots": {
      "trailing": { "default-visible": true, "default-icon": "icon/chevron-down", "persistent": true }
    },
    "dropdown": {
      "bg": "color/surface/surface-1",
      "fg": "color/surface/on-surface",
      "hover-bg": "color/surface/surface-2",
      "shadow": "effects/shadow-2",
      "radius": "radius/input"
    },
    "item": {
      "sizes": {
        "sm": { "height": "height/menu-item-sm", "x-padding": "{scale.2}", "gap": "{scale.1}", "text": "action/sm" },
        "md": { "height": "height/menu-item-md", "x-padding": "{scale.3}", "gap": "{scale.2}", "text": "action/md" },
        "lg": { "height": "height/menu-item-lg", "x-padding": "{scale.4}", "gap": "{scale.2}", "text": "action/lg" }
      }
    },
    "empty": {
      "fg": "color/surface/on-surface-variant",
      "text": "body/sm"
    },
    "default": { "state": "default", "size": "md" }
  },

  "slider": {
    "$note": "Single value or range slider. Track + thumb model. Range variant has two thumbs — code-only distinction, same visual config. Always pair with a visible value label.",
    "variants": {
      "default": { "track-bg": "color/surface/surface-1", "fill-bg": "color/primary/primary", "thumb-bg": "color/primary/primary" }
    },
    "sizes": {
      "$constant": { "track-radius": "radius/pill", "thumb-radius": "radius/pill" },
      "sm": { "track-height": "{scale.1}", "thumb-size": "16px" },
      "md": { "track-height": "{scale.1}", "thumb-size": "20px" },
      "lg": { "track-height": "{scale.2}", "thumb-size": "24px" }
    },
    "default": { "variant": "default", "size": "md" }
  },

  "file-upload": {
    "$note": "Dropzone — drag-and-drop / click-to-browse area, dashed while it is still asking for a file and solid once an upload has settled (see `settled`). Single-variant (the dropzone IS the atom; a button trigger is just a button). The dropzone is stateless — it fires onFilesSelected and owns no file array; the FileUploadItem subcomponent renders the selected-files list the consumer maps over. `dragover` is an internal runtime state (drag highlight), NOT a consumer-facing variant. `uploading` is code-only.",
    "variants": {
      "default": { "bg": "color/surface/surface", "fg": "color/surface/on-surface", "border": "color/outline/outline", "icon-fg": "color/surface/on-surface-variant" }
    },
    "dragover": { "bg": "color/primary/primary-container", "fg": "color/primary/on-primary-container", "border": "color/primary/primary", "icon-fg": "color/primary/primary" },
    "settled": {
      "$note": "Border style carries whether the dropzone is still asking for a file. Dashed reads as an open target; once an upload has resolved the box is reporting, not inviting, so it takes a full stroke. `uploading` stays dashed — nothing has been uploaded yet.",
      "border-style": "solid",
      "success": { "border": "color/success/success", "icon-fg": "color/success/success" },
      "error": { "border": "color/error/error", "icon-fg": "color/error/error" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 400,
      "letter-spacing": "0",
      "text-transform": "none"
    },
    "sizes": {
      "$constant": { "radius": "radius/card", "border-style": "dashed", "border-width": "border-width/bw-2" },
      "sm": { "x-padding": "{scale.4}", "y-padding": "{scale.4}", "gap": "{scale.2}", "icon-size": "icon/icon-2" },
      "md": { "x-padding": "{scale.6}", "y-padding": "{scale.6}", "gap": "{scale.3}", "icon-size": "icon/icon-3" },
      "lg": { "x-padding": "{scale.8}", "y-padding": "{scale.8}", "gap": "{scale.4}", "icon-size": "icon/icon-4" }
    },
    "default": { "variant": "default", "size": "md" }
  },

  "input-otp": {
    "$note": "One-time password input. Row of individual character cells. Auto-advance on digit entry, paste support required. Separated boxes variant — each cell is a standalone input box.",
    "state": {
      "default": { "bg": "color/surface/surface", "fg": "color/surface/on-surface", "border": "color/outline/outline" },
      "focused": { "bg": "color/surface/surface", "fg": "color/surface/on-surface", "border": "color/primary/primary" },
      "error":   { "bg": "color/surface/surface", "fg": "color/surface/on-surface", "border": "color/error/error" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 600,
      "letter-spacing": "0.1em",
      "text-transform": "none"
    },
    "$exception": "OTP cells are square — width equals height. Monospace-like letter-spacing ensures centered digits. Cell sizes are hardcoded to maintain square proportions.",
    "sizes": {
      "$constant": { "radius": "radius/input" },
      "sm": { "cell-size": "height/control-sm", "gap": "{scale.2}", "text": "title/sm", "border-width": "border-width/bw-1" },
      "md": { "cell-size": "height/control-md", "gap": "{scale.2}", "text": "title/md", "border-width": "border-width/bw-1" },
      "lg": { "cell-size": "height/control-lg", "gap": "{scale.3}", "text": "title/lg", "border-width": "border-width/bw-2" }
    },
    "default": { "state": "default", "size": "md" }
  },

  "label": {
    "state": {
      "default": { "fg": "color/surface/on-surface" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 500,
      "text-transform": "none"
    },
    "sizes": {
      "sm": { "line-height": "16px" },
      "md": { "line-height": "20px" },
      "lg": { "line-height": "24px" }
    },
    "default": { "state": "default", "size": "md" }
  },

  "helper-text": {
    "state": {
      "default": { "fg": "color/surface/on-surface-variant" },
      "error":   { "fg": "color/error/error" }
    },
    "typography": {
      "font-family": "body",
      "font-weight": 400,
      "text-transform": "none"
    },
    "$exception": "Helper text sm font-size (11px) is below the caption preset minimum (12px) — must remain visually subordinate to label at every size tier.",
    "sizes": {
      "sm": { "line-height": "16px" },
      "md": { "line-height": "16px" },
      "lg": { "line-height": "20px" }
    },
    "default": { "state": "default", "size": "md" }
  },

  "calendar": {
    "$note": "Calendar grid panel for date selection. Used standalone (scheduling views) or as the dropdown panel inside date-picker. Day cells are buttons semantically (interactive, trigger selection). Full keyboard navigation (arrow keys between days, page up/down for months).",
    "variants": {
      "default": { "bg": "color/surface/surface-1", "fg": "color/surface/on-surface", "border": "color/outline/outline", "shadow": "effects/shadow-2" }
    },
    "day": {
      "state": {
        "default":  { "bg": "transparent", "fg": "color/surface/on-surface" },
        "selected": { "bg": "color/primary/primary", "fg": "color/primary/on-primary" },
        "today":    { "bg": "transparent", "fg": "color/primary/primary", "border": "color/primary/primary" },
        "hover":    { "bg": "color/surface/surface-2", "fg": "color/surface/on-surface" },
        "disabled": { "bg": "transparent", "fg": "color/surface/on-surface-variant" },
        "range":    { "bg": "color/primary/primary-container", "fg": "color/primary/on-primary-container" }
      }
    },
    "header-typography": {
      "font-family": "body",
      "font-weight": 600,
      "letter-spacing": "0",
      "text-transform": "none"
    },
    "day-typography": {
      "font-family": "body",
      "font-weight": 400,
      "letter-spacing": "0",
      "text-transform": "none"
    },
    "sizes": {
      "$constant": { "radius": "radius/card", "day-radius": "radius/component" },
      "compact": { "width": "208px", "x-padding": "{scale.1}", "y-padding": "{scale.1}", "gap": "{scale.1}", "header-text": "action/sm", "nav-height": "16px", "day-text": "action/sm", "nav-icon": "icon/icon-1" },
      "sm": { "width": "240px", "x-padding": "{scale.2}", "y-padding": "{scale.2}", "gap": "{scale.1}", "header-text": "action/md", "nav-height": "20px", "day-text": "action/sm", "nav-icon": "icon/icon-1" },
      "md": { "width": "280px", "x-padding": "{scale.3}", "y-padding": "{scale.3}", "gap": "{scale.1}", "header-text": "action/md", "nav-height": "20px", "day-text": "action/md", "nav-icon": "icon/icon-2" },
      "lg": { "width": "320px", "x-padding": "{scale.4}", "y-padding": "{scale.4}", "gap": "{scale.2}", "header-text": "action/lg", "nav-height": "24px", "day-text": "action/lg", "nav-icon": "icon/icon-2" }
    },
    "default": { "variant": "default", "size": "md" }
  },

  "time-picker": {
    "$catalog": {
      "category": "form",
      "description": "Time picker — composes three Select atoms (hour / minute / period). 12h or 24h, configurable minute step.",
      "dependencies": ["cn", "select"],
      "tokens": ["color", "typography", "spacing", "sizing"],
      "composition": "none"
    },
    "$note": "Option A — composes Select (no input masking). Paired with date-picker. `use24Hour` drops the period select and switches the hour range; `minuteStep` controls the minute options.",
    "sizes": {
      "sm": {},
      "md": {},
      "lg": {}
    },
    "default": { "size": "md" }
  }
}
