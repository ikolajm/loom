{
  "$note": "Generated from \"standard\" type scale + font pairing (Inter / Inter). Text style families with sm/md/lg tiers. Components bind to a family; the size prop selects the tier. Change via questionnaire, not manual editing.",
  "families": {
    "heading": "Inter",
    "body": "Inter"
  },
  "textStyles": {
    "display": {
      "font": "heading",
      "weight": 700,
      "letter-spacing": "-0.02em",
      "sm": {
        "size": "32px",
        "line-height": "40px"
      },
      "md": {
        "size": "36px",
        "line-height": "44px"
      },
      "lg": {
        "size": "48px",
        "line-height": "56px"
      }
    },
    "title": {
      "font": "heading",
      "weight": 600,
      "letter-spacing": "-0.01em",
      "sm": {
        "size": "18px",
        "line-height": "24px"
      },
      "md": {
        "size": "20px",
        "line-height": "28px"
      },
      "lg": {
        "size": "24px",
        "line-height": "32px"
      }
    },
    "body": {
      "font": "body",
      "weight": 400,
      "letter-spacing": "0",
      "sm": {
        "size": "14px",
        "line-height": "20px"
      },
      "md": {
        "size": "16px",
        "line-height": "24px"
      },
      "lg": {
        "size": "18px",
        "line-height": "28px"
      }
    },
    "action": {
      "font": "body",
      "weight": 500,
      "letter-spacing": "0.01em",
      "sm": {
        "size": "12px",
        "line-height": "16px"
      },
      "md": {
        "size": "14px",
        "line-height": "20px"
      },
      "lg": {
        "size": "16px",
        "line-height": "24px"
      }
    },
    "label": {
      "$note": "Same sizes as action, deliberately. label and action are not two scales, they are two settings of one scale: label tracks wider and leads tighter than action at every tier, which is what a chip, a kbd key or a nav label wants and what a button does not. Weight matches. The ramp is floored so that no tier emits below the smallest size platform guidance supports: WCAG sets no minimum font size, but iOS HIG and Material both floor around 11, and the tier that sat under that reached badge, kbd and helper-text at their smallest size.",
      "font": "body",
      "weight": 500,
      "letter-spacing": "0.02em",
      "sm": {
        "size": "12px",
        "line-height": "14px"
      },
      "md": {
        "size": "14px",
        "line-height": "16px"
      },
      "lg": {
        "size": "16px",
        "line-height": "20px"
      }
    },
    "input": {
      "font": "body",
      "weight": 400,
      "letter-spacing": "0",
      "sm": {
        "size": "14px",
        "line-height": "20px"
      },
      "md": {
        "size": "16px",
        "line-height": "24px"
      },
      "lg": {
        "size": "18px",
        "line-height": "28px"
      }
    }
  }
}
