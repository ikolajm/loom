# Clean-room differential token sweep. See docker/README.md.
#
# Debian slim rather than alpine: Next is not built here, but the install image
# shares this base choice and SWC's prebuilt binaries are glibc-linked, so the
# two images stay on one runtime rather than diverging for no reason.
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-slim

# git is not needed to run the sweep — the build context is the working tree, and
# .dockerignore excludes .git/ deliberately. diffutils is; slim does not carry it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends diffutils ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /loom

# The root package.json declares no dependencies — the generator is dependency-free
# Node — so there is no install step here and nothing to cache. If that ever stops
# being true, this is where it changes.
COPY . /loom
RUN chmod +x docker/sweep.sh

ENV LOOM_ROOT=/loom
ENTRYPOINT ["docker/sweep.sh"]
