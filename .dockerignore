# Build context for docker/ — see docker/README.md.
#
# This file is what makes the clean room clean. Every entry below is state that
# survives between runs on a developer machine and silently decides a result:
# a local config set the generators prefer over the committed one, an answers
# file holding someone's brand, an installed node_modules. A container that
# inherited any of them would be testing that machine, not this repo.

.git/
node_modules/
**/node_modules/

# Generated on demand — the container regenerates everything it needs.
generated/
.next/
out/
dist/
*.tsbuildinfo

# The two paths that decide which brand a run builds. Their absence is the
# point: with no local set present, the generators fall back to the committed
# spec/config/base/, which is the only state a fresh consumer can be in.
spec/answers.json
spec/config/local/

# Regenerated by the playground's own predev/prebuild hook.
catalog-playground/src/tokens.css

*.log
.env*
.DS_Store
